# ==============================================================================
# OS Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==============================================================================
# IDEs and Editors
# ==============================================================================
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================================================================
# Node / Frontend / Backend dependencies & builds
# ==============================================================================
node_modules/
/app/frontend/dist/
/app/frontend/build/
/app/backend/dist/
/app/backend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.eslintcache

# ==============================================================================
# Terraform / Infrastructure
# ==============================================================================
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and user names.
*.tfvars
*.tfvars.json

# Ignore override files as they may contain local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using !
# !override.tf

# Include backend configuration override
# !backend.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ==============================================================================
# Kubernetes / Helm
# ==============================================================================
*.kubeconfig
kubeconfig
.kube/
# Helm charts dependencies and packaging
**/charts/*.tgz
**/charts/tmp/

# ==============================================================================
# Secrets and Credentials
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.pub
secrets/
credentials/
aws-creds*
